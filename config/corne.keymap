#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        hrm_l: hrm_l {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <18 19 21 22 23 30 31 32 33 34 35 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35>;
            require-prior-idle-ms = <130>;
        };

        hrm_r: hrm_r {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <2 4 5 12 13 14 15 16 17 24 25 26 27 28 29 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29>;
            hold-trigger-on-release;
            require-prior-idle-ms = <130>;
        };

        special_l: special_l {
            compatible = "zmk,behavior-hold-tap";
            label = "SPECIAL_L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <250>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <18 19 21 22 23 30 31 32 33 34 35 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            require-prior-idle-ms = <40>;
        };

        special_r: special_r {
            compatible = "zmk,behavior-hold-tap";
            label = "SPECIAL_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <250>;
            flavor = "balanced";
            hold-trigger-key-positions = <2 4 5 12 13 14 15 16 17 24 25 26 27 28 29 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
            require-prior-idle-ms = <40>;
        };
    };

    macros {
        rust_arrow: rust_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp MINUS &kp GT>;

            label = "RUST_ARROW";
        };

        rust_arrow_fat: rust_arrow_fat {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp EQUAL &kp GT>;

            label = "RUST_ARROW_FAT";
        };

        rust_turbo_fish: rust_turbo_fish {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp COLON &kp COLON &kp LT &kp GT>;

            label = "RUST_TURBO_FISH";
        };

        rust_closure: rust_closure {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp PIPE &kp X &kp PIPE>;

            label = "RUST_CLOSURE";
        };

        rust_annotate: rust_annotate {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp POUND &kp LBKT &kp RBKT>;

            label = "RUST_ANNOTATE";
        };

        logic_eq_not: logic_eq_not {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp EXCL &kp EQUAL>;

            label = "LOGIC_EQ_NOT";
        };

        logic_lt: logic_lt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp LT &kp EQUAL>;

            label = "LOGIC_LT";
        };

        logic_gt: logic_gt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp GT &kp EQUAL>;

            label = "LOGIC_GT";
        };

        logic_and: logic_and {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp AMPS &kp AMPS>;

            label = "LOGIC_AND";
        };

        logic_or: logic_or {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp PIPE &kp PIPE>;

            label = "LOGIC_OR";
        };

        logic_bit_left: logic_bit_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp LT &kp LT>;

            label = "LOGIC_BIT_LEFT";
        };

        logic_bit_right: logic_bit_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp GT &kp GT>;

            label = "LOGIC_BIT_RIGHT";
        };

        logic_assign_plus: logic_assign_plus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp PLUS &kp EQUAL>;

            label = "LOGIC_ASSIGN_PLUS";
        };

        logic_assign_minus: logic_assign_minus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp MINUS &kp EQUAL>;

            label = "LOGIC_ASSIGN_MINUS";
        };

        logic_assign_mult: logic_assign_mult {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp STAR &kp EQUAL>;

            label = "LOGIC_ASSIGN_MULT";
        };

        logic_assign_div: logic_assign_div {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp FSLH &kp EQUAL>;

            label = "LOGIC_ASSIGN_DIV";
        };

        vim_ci: vim_ci {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp C &kp I>;

            label = "VIM_CI";
        };

        vim_di: vim_di {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp D &kp I>;

            label = "VIM_DI";
        };

        vim_yi: vim_yi {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp Y &kp I>;

            label = "VIM_YI";
        };

        vim_vi: vim_vi {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp V &kp I>;

            label = "VIM_VI";
        };

        vim_ddkp: vim_ca {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp D &kp D &kp K &kp LS(P)>;

            label = "VIM_CA";
        };

        vim_ddp: vim_da {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp D &kp D &kp P>;

            label = "VIM_DA";
        };

        vim_yyp: vim_ya {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp Y &kp Y &kp P>;

            label = "VIM_YA";
        };

        vim_nav_win: vim_va {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp LC(W)>;

            label = "VIM_VA";
        };

        vim_gcc: vim_gcc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp G &kp C &kp C>;

            label = "VIM_GCC";
        };

        vim_copy_page: vim_copy_page {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp G &kp G &kp LS(V) &kp LS(G) &kp DOUBLE_QUOTES &kp PLUS &kp Y>;

            label = "VIM_COPY_PAGE";
        };

        ctrl_c: ctrl_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(C)>;
            label = "CTRL_C";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&special_l TAB TAB          &kp Q               &kp W              &kp E                  &kp R                &kp T                           &kp Y                   &kp U                 &kp I                   &kp O               &kp P                       &special_r BACKSPACE BACKSPACE
&special_l CAPSLOCK ESCAPE  &hrm_l LEFT_META A  &hrm_l LEFT_ALT S  &hrm_l LEFT_CONTROL D  &hrm_l LEFT_SHIFT F  &kp G                           &kp H                   &hrm_r RIGHT_SHIFT J  &hrm_r RIGHT_CONTROL K  &hrm_r RIGHT_ALT L  &hrm_r RIGHT_GUI SEMICOLON  &kp SQT
&special_l DELETE DELETE    &kp Z               &kp X              &kp C                  &kp V                &kp B                           &kp N                   &kp M                 &kp COMMA               &kp DOT             &kp FSLH                    &kp BACKSLASH
                                                                   &mo 3                  &mo 1                &special_l LEFT_SHIFT RETURN    &special_r SPACE SPACE  &mo 2                 &mo 4
            >;
        };

        sym {
            bindings = <
&special_l TILDE GRAVE           &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4      &kp NUMBER_5         &kp NUMBER_6    &kp NUMBER_7     &kp NUMBER_8   &kp NUMBER_9          &kp NUMBER_0           &special_r (LC(BACKSPACE)) LC(BACKSPACE)
&trans                           &kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR        &kp PERCENT          &kp CARET       &kp AMPERSAND    &kp ASTERISK   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&special_l (LC(DEL)) LC(DELETE)  &kp MINUS        &kp PLUS      &kp EQUAL     &kp LEFT_BRACKET  &kp RIGHT_BRACKET    &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LESS_THAN  &kp GREATER_THAN      &kp UNDER              &trans
                                                                &trans        &trans            &trans               &trans          &trans           &trans
            >;
        };

        nav {
            bindings = <
&trans   &kp PAGE_UP    &kp HOME        &kp UP_ARROW    &kp END          &kp INSERT    &vim_copy_page  &vim_yi         &vim_vi        &vim_ci          &vim_di       &vim_ddkp
&ctrl_c  &kp PAGE_DOWN  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp DELETE    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW   &kp RIGHT_ARROW  &vim_nav_win  &vim_yyp
&trans   &kp K_UNDO     &kp K_CUT       &kp K_COPY      &kp K_PASTE      &kp K_REDO    &kp LS(LC(O))   &kp LS(LC(D))   &kp LS(LC(U))  &kp LS(LC(I))    &vim_gcc      &vim_ddp
                                        &trans          &trans           &trans        &trans          &trans          &trans
            >;
        };

        macros {
            bindings = <
&trans  &rust_annotate  &rust_closure  &rust_arrow_fat  &rust_arrow  &rust_turbo_fish    &trans           &trans            &trans              &trans               &trans              &trans
&trans  &logic_lt       &logic_gt      &logic_eq_not    &logic_and   &logic_or           &logic_bit_left  &logic_bit_right  &logic_assign_plus  &logic_assign_minus  &logic_assign_mult  &logic_assign_div
&trans  &trans          &trans         &trans           &trans       &trans              &trans           &trans            &trans              &trans               &vim_gcc            &trans
                                       &trans           &trans       &trans              &trans           &trans            &trans
            >;
        };

        media {
            bindings = <
&trans  &kp F1                &kp F2  &kp F3  &kp F4                &kp F5    &kp F6  &kp F7            &kp F8        &kp F9           &kp F10  &kp PRINTSCREEN
&trans  &kp C_PREV            &trans  &trans  &kp C_NEXT            &trans    &trans  &kp C_MUTE        &kp C_VOL_DN  &kp C_VOLUME_UP  &kp F11  &trans
&trans  &kp C_BRIGHTNESS_DEC  &trans  &trans  &kp C_BRIGHTNESS_INC  &trans    &trans  &kp C_PLAY_PAUSE  &trans        &trans           &kp F12  &trans
                                      &trans  &trans                &trans    &trans  &trans            &trans
            >;
        };

        bt {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&bt BT_CLR  &bt BT_CLR_ALL  &trans         &trans         &trans         &trans           &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_NXT  &bt BT_SEL 0    &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4     &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_PRV  &bt BT_DISC 0   &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4    &trans  &trans  &trans  &trans  &trans  &trans
                                           &trans         &trans         &trans           &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        bt_layer {
            if-layers = <1 3>;
            then-layer = <5>;
        };
    };
};
