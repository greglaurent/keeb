#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        hrm_l: hrm_l {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <18 19 21 22 23 30 31 32 33 34 35 39 40 41 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            require-prior-idle-ms = <60>;
        };

        hrm_r: hrm_r {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <2 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
            require-prior-idle-ms = <60>;
        };
    };

    macros {
        rust_arrow: rust_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp MINUS &kp GT>;

            label = "RUST_ARROW";
        };

        rust_arrow_fat: rust_arrow_fat {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp EQUAL &kp GT>;

            label = "RUST_ARROW_FAT";
        };

        rust_turbo_fish: rust_turbo_fish {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp COLON &kp LT &kp GT>, <&macro_press>;

            label = "RUST_TURBO_FISH";
        };

        rust_closure: rust_closure {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp PIPE &kp X &kp PIPE>, <&macro_press>;

            label = "RUST_CLOSURE";
        };

        rust_annotate: rust_annotate {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp POUND &kp LBKT &kp RBKT>, <&macro_press>;

            label = "RUST_ANNOTATE";
        };

        logic_eq_not: logic_eq_not {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp EXCL &kp EQUAL>;

            label = "LOGIC_EQ_NOT";
        };

        logic_lt: logic_lt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp LT &kp EQUAL>;

            label = "LOGIC_LT";
        };

        logic_gt: logic_gt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp GT &kp EQUAL>;

            label = "LOGIC_GT";
        };

        logic_and: logic_and {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp AMPS &kp AMPS>;

            label = "LOGIC_AND";
        };

        logic_or: logic_or {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp PIPE &kp PIPE>;

            label = "LOGIC_OR";
        };

        logic_bit_left: logic_bit_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp LT &kp LT>;

            label = "LOGIC_BIT_LEFT";
        };

        logic_bit_right: logic_bit_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp GT &kp GT>;

            label = "LOGIC_BIT_RIGHT";
        };

        logic_assign_plus: logic_assign_plus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp PLUS &kp EQUAL>;

            label = "LOGIC_ASSIGN_PLUS";
        };

        logic_assign_minus: logic_assign_minus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp EQUAL>, <&macro_press>;

            label = "LOGIC_ASSIGN_MINUS";
        };

        logic_assign_mult: logic_assign_mult {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp STAR &kp EQUAL>;

            label = "LOGIC_ASSIGN_MULT";
        };

        logic_assign_div: logic_assign_div {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp FSLH &kp EQUAL>;

            label = "LOGIC_ASSIGN_DIV";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&hrm_l TAB TAB        &kp Q               &kp W              &kp E                  &kp R                &kp T        &kp Y               &kp U                 &kp I                   &kp O               &kp P                       &hrm_r BACKSPACE BACKSPACE
&kp ESCAPE            &hrm_l LEFT_META A  &hrm_l LEFT_ALT S  &hrm_l LEFT_CONTROL D  &hrm_l LEFT_SHIFT F  &kp G        &kp H               &hrm_r RIGHT_SHIFT J  &hrm_r RIGHT_CONTROL K  &hrm_r RIGHT_ALT L  &hrm_r RIGHT_GUI SEMICOLON  &kp SQT
&hrm_l DELETE DELETE  &kp Z               &kp X              &kp C                  &kp V                &kp B        &kp N               &kp M                 &kp COMMA               &kp DOT             &kp FSLH                    &kp BACKSLASH
                                                             &mo 3                  &mo 1                &kp ENTER    &hrm_r SPACE SPACE  &mo 2                 &mo 4
            >;
        };

        sym {
            bindings = <
&kp GRAVE                  &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4      &kp NUMBER_5         &kp NUMBER_6    &kp NUMBER_7     &kp NUMBER_8   &kp NUMBER_9          &kp NUMBER_0           &hrm_r LC(BACKSPACE) LC(BACKSPACE)
&trans                     &kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR        &kp PERCENT          &kp CARET       &kp AMPERSAND    &kp ASTERISK   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&hrm_l LC(DEL) LC(DELETE)  &kp MINUS        &kp PLUS      &kp EQUAL     &kp LEFT_BRACKET  &kp RIGHT_BRACKET    &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LESS_THAN  &kp GREATER_THAN      &kp UNDER              &trans
                                                          &trans        &trans            &trans               &trans          &trans           &trans
            >;
        };

        macros {
            bindings = <
&trans      &rust_annotate  &rust_closure  &rust_arrow_fat  &rust_arrow  &rust_turbo_fish    &trans           &trans            &trans              &trans               &trans              &trans
&caps_word  &logic_lt       &logic_gt      &logic_eq_not    &logic_and   &logic_or           &logic_bit_left  &logic_bit_right  &logic_assign_plus  &logic_assign_minus  &logic_assign_mult  &logic_assign_div
&trans      &trans          &trans         &trans           &trans       &trans              &trans           &trans            &trans              &trans               &trans              &trans
                                           &trans           &trans       &trans              &trans           &trans            &trans
            >;
        };

        func {
            bindings = <
&trans  &kp F1  &kp F2    &kp F3     &kp F4   &kp F5                  &kp F6            &kp F7             &kp F8           &kp F9                &kp F10  &kp PRINTSCREEN
&trans  &trans  &kp HOME  &kp PG_UP  &kp END  &kp C_AC_SCROLL_UP      &kp C_MUTE        &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_BRIGHTNESS_INC  &kp F11  &trans
&trans  &trans  &trans    &kp PG_DN  &trans   &kp C_AC_SCROLL_DOWN    &kp C_PREV        &kp C_PLAY_PAUSE   &kp C_NEXT       &kp C_BRIGHTNESS_DEC  &kp F12  &trans
                          &trans     &trans   &trans                  &kp C_PLAY_PAUSE  &trans             &trans
            >;
        };

        bt {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&bt BT_CLR  &bt BT_CLR_ALL  &trans         &trans         &trans         &trans           &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_NXT  &bt BT_SEL 0    &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4     &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_PRV  &bt BT_DISC 0   &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4    &trans  &trans  &trans  &trans  &trans  &trans
                                           &trans         &trans         &trans           &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        bt_layer {
            if-layers = <3 2>;
            then-layer = <4>;
        };
    };
};
